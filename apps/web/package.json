{
  "name": "@interiores/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "prebuild": "pnpm --filter @interiores/contract build && node scripts/vendor-pascal-assets.mjs --check",
    "build": "next build",
    "start": "next start",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run && tsx scripts/build-templates.ts --check",
    "templates:build": "tsx scripts/build-templates.ts",
    "templates:thumbs": "node scripts/capture-templates.mjs",
    "items:thumbs": "node scripts/item-thumbnails.mjs",
    "editor:shots": "node scripts/capture-editor.mjs",
    "assets:vendor": "node scripts/vendor-pascal-assets.mjs",
    "fonts:pdf": "node scripts/vendor-pdf-fonts.mjs",
    "brand:build": "tsx scripts/build-brand-paths.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@interiores/contract": "workspace:*",
    "@pascal-app/core": "1.0.3",
    "@pascal-app/editor": "1.0.3",
    "@pascal-app/nodes": "1.0.3",
    "@pascal-app/viewer": "1.0.3",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
