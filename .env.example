# Desarrollo y pruebas contra Supabase LOCAL (Docker):
#   pnpm db:start   -> levanta Supabase local (la primera vez descarga imágenes)
#   pnpm db:env     -> escribe .env.test, apps/api/.env y apps/web/.env.local con las claves locales
# Este archivo solo documenta las variables. NUNCA subas archivos .env reales ni claves de la nube.

# --- .env.test (pruebas; la service_role solo existe aquí) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon key local>
SUPABASE_SERVICE_ROLE_KEY=<service_role key local>

# --- apps/api/.env ---
# SUPABASE_URL y SUPABASE_ANON_KEY como arriba
CORS_ORIGINS=http://localhost:3000
PORT=3001
# Opcionales, para «Muebles desde una foto» (docs/nube.md, sección 11). Sin la clave la API arranca y el análisis responde 503.
# `pnpm db:env` reescribe este archivo sin estas líneas: vuelve a agregarlas o define la clave solo en la terminal de la API.
# GEMINI_API_KEY=<tu clave de Google AI Studio>
# VISION_MODEL=gemini-3.5-flash

# --- apps/web/.env.local ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key local>
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_E2E=1

# --- Nube (sin Docker; guía en docs/nube.md) ---
# pnpm db:env:cloud lee SUPABASE_URL y SUPABASE_ANON_KEY del entorno o de .env.cloud (modelo: .env.cloud.example)
# y escribe apps/api/.env y apps/web/.env.local apuntando al Supabase de desarrollo. No escribe .env.test:
# las pruebas de RLS y las E2E siguen necesitando la base local.
# En Vercel las variables se cargan en el panel de cada proyecto (web y api; lista en docs/nube.md), sin NEXT_PUBLIC_E2E.
SUPABASE_DEV_PROJECT_REF=<project-ref de la nube para el MCP de solo lectura>
