{
  "name": "interiores",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && vitest run",
    "build": "pnpm -r --if-present build",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "supabase": "npx --yes supabase@2.120.0",
    "db:start": "npx --yes supabase@2.120.0 start",
    "db:stop": "npx --yes supabase@2.120.0 stop",
    "db:reset": "npx --yes supabase@2.120.0 db reset",
    "db:env": "node scripts/local-env.mjs",
    "db:seed": "node scripts/seed-users.mjs",
    "lab:setup": "node scripts/lab-setup.mjs",
    "lab:tp3": "node scripts/lab-tp3.mjs",
    "lab:tp3:test": "node scripts/lab-tp3-test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
