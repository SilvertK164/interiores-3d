# Se copia a lab/.env.local (ese archivo NO se sube al repositorio) y se completa con tu clave:
#   Copy-Item lab/.env.example lab/.env.local
# `pnpm lab:tp3` lo lee al arrancar y nunca imprime la clave. Formato CLAVE=valor, una por línea.

# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: modelo de visión (si queda vacío, TP3 usa su modelo por defecto)
# VISION_MODEL=

# Opcional: orígenes desde los que TP3 acepta fotos, separados por coma (por defecto, nuestra web local)
# CORS_ORIGINS=http://localhost:3000
